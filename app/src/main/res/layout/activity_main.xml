<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <fan.miuixbase.widget.FilterSortView2
        android:id="@+id/main_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <fan.miuixbase.widget.FilterSortTabView
            android:id="@+id/tab_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_settings" />

        <fan.miuixbase.widget.FilterSortTabView
            android:id="@+id/tab_logs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_logs" />

        <fan.miuixbase.widget.FilterSortTabView
            android:id="@+id/tab_about"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_about" />
    </fan.miuixbase.widget.FilterSortView2>

    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
